{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/dashboard-v2.html" },
    { "source": "/admin", "destination": "/dashboard-v2.html" },
    { "source": "/tong-quan", "destination": "/dashboard-v2.html" },
    { "source": "/production", "destination": "/dashboard-v2.html" },
    { "source": "/bluescope", "destination": "/dashboard-v2.html" },
    { "source": "/public", "destination": "/bluescope-public.html" },
    { "source": "/bluescope-public", "destination": "/bluescope-public.html" }
  ],
  "headers": [
    {
      "source": "/(money2026-seed|bluescope-public-data)\\.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
      ]
    }
  ]
}
